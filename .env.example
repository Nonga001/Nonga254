# .env.example
# Copy this file to .env and fill in your values

# Email Configuration (for contact form)
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# Database (if using one)
# DATABASE_URL=

# Analytics
# NEXT_PUBLIC_GA_ID=

# EmailJS Configuration (Contact Form)
# Obtain these from your EmailJS dashboard: https://dashboard.emailjs.com/
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here
# Optional: only if you enabled Private Key / Access Token in EmailJS Security settings
# EMAILJS_PRIVATE_KEY=your_private_key_here

# API URLs
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Environment
NODE_ENV=development